# ==============================================================================
# config.env.example — Environment Configuration Template for teslaagent
# Copy this file to config.env and update it for your environment:
#   cp scripts/config.env.example scripts/config.env
# ==============================================================================

# --- Path and Server Configurations ---
# Directory where GGUF model files are stored
TESLA_MODELS_DIR="${HOME}/models"

# Path to the primary Qwen 3.6 35B MoE GGUF file
TESLA_GGUF_PATH="${TESLA_MODELS_DIR}/qwen3.6-35b-a3b/Qwen3.6-35B-A3B-MXFP4_MOE.gguf"

# Path to the Lemonade ROCm llama-server binary
TESLA_LLAMA_SERVER="${HOME}/.cache/lemonade/bin/llamacpp/rocm-stable/llama-server"

# Path to Vulkan llama-server binary (leave blank to default to ROCm server)
TESLA_VULKAN_SERVER=""

# --- Port and Context Settings ---
# Port for serving the model API
TESLA_PORT=8095

# Context size (in tokens) for loading the model. Qwen 3.6 MoE supports up to 32k.
TESLA_CTX_SIZE=32768

# --- Agent Settings ---
# Directory where Hermes configuration files are stored
TESLA_HERMES_HOME="${HOME}/.hermes"

# Hermes agent profile name
TESLA_HERMES_PROFILE="qwen36_mxfp4"

# --- AMD GPU (gfx1151) Hardware Driver Settings ---
# Override GPU architecture to make gfx1151 compatible with ROCm
HSA_OVERRIDE_GFX_VERSION=11.5.1

# Disable system DMA (SDMA) to prevent kernel hangs on unified memory
HSA_ENABLE_SDMA=0

# Let ROCm allocate up to 100% of memory resources
GPU_MAX_HEAP_SIZE=100
GPU_MAX_ALLOC_PERCENT=100
GPU_SINGLE_ALLOC_PERCENT=100
GPU_FORCE_64BIT_PTR=1

# Expose the primary APU GPU (0 is default, set to -1 to force Vulkan route)
HIP_VISIBLE_DEVICES=0

# Use RADV ICD for Vulkan execution (Mesa RADV)
AMD_VULKAN_ICD=RADV
GGML_CUDA_ENABLE_UNIFIED_MEMORY=ON
